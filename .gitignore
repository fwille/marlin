.env*.local

# typescript
*.tsbuildinfo

# test coverage
coverage/

example

# generated native folders
/ios

# stray extracted JAR contents accidentally unzipped at the repo root
# (gradle-wrapper.jar / react-native-gradle-plugin jars — the real ones live
# in android/gradle/wrapper and node_modules)
/META-INF/
/com/
/org/

# Claude Code local config, runtime state, and skills (machine/session-specific)
.claude/

# Claude Code skills — locally installed tooling, regenerated from skills-lock.json
# (same reasoning as node_modules/: not part of the app, fetched on demand)
.agents/
skills-lock.json
